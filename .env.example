# ==========================================
# Outdoor Activity Safety Advisor Environment Config
# ==========================================

# LLM Provider: "gemini", "groq", "ollama", or "mock"
LLM_PROVIDER=gemini

# Google Gemini (Primary / Active Free LLM)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud (Free Tier alternative)
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Ollama Local Offline Fallback
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b-instruct

# Open-Meteo API Endpoints (Free, no key required)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
SOPS_DIR=./sops
